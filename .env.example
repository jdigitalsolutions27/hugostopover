# Public Supabase connection values. The publishable key is safe for the browser
# only because database and storage access are protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Public canonical URL used for metadata, sitemap, and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: comma-separated hosts allowed to invoke Server Actions through a proxy/CDN.
SERVER_ACTION_ALLOWED_ORIGINS=

# Never add SUPABASE_SERVICE_ROLE_KEY to Vercel browser-exposed variables.
# This application does not require the service-role key at runtime.
